CORS_ORIGINS=http://localhost:3000
# LLM provider: "mock" (no network), "groq", or "openai" (all OpenAI-compatible).
LLM_PROVIDER=mock
# API key from the provider console. Never commit the real value.
LLM_API_KEY=<your-api-key>
# OpenAI-compatible API endpoint (Groq's is https://api.groq.com/openai/v1).
LLM_BASE_URL=https://api.groq.com/openai/v1
# Any hosted model id available on the chosen endpoint.
LLM_MODEL=<model-id>
# Per-request timeout in seconds.
LLM_TIMEOUT=30
