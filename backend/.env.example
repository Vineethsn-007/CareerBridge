[TEMPLATE]
CORS_ORIGINS=http://localhost:3000
# LLM provider: "mock" (no network), "groq", or "openai" (all OpenAI-compatible).
LLM_PROVIDER=mock
# API key from the provider console. Never commit the real value.
LLM_API_KEY=<your-api-key>
# OpenAI-compatible API endpoint (Groq's is https://api.groq.com/openai/v1).
LLM_BASE_URL=https://api.groq.com/openai/v1
# Main model id used for most calls (default: openai/gpt-oss-120b).
LLM_MODEL=openai/gpt-oss-120b
# Smaller model id for inexpensive calls such as bulk normalization (optional).
LLM_FAST_MODEL=openai/gpt-oss-20b
# Per-request timeout in seconds.
LLM_TIMEOUT=30
# SQLAlchemy database URL. SQLite by default; use PostgreSQL in deployment.
DATABASE_URL=sqlite:///./careerbridge.db

# Task 4 scraper (all optional; scraper is admin-triggered only)
ADMIN_TOKEN=change-me-strong-token
# SCRAPER_USER_AGENT=CareerBridge-Scraper/0.1 (+https://github.com/Vineethsn-007/CareerBridge)
# SCRAPER_TIMEOUT=20
# SCRAPER_REQUEST_INTERVAL=2.0
# SCRAPER_MAX_LISTINGS=25
# SCRAPER_STALE_DAYS=14
# YouTube Data API v3 key for verified prep-resource videos (optional for now).
YOUTUBE_API_KEY=<your-youtube-api-key>
