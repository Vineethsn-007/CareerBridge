# ==============================================================================
# CareerBridge Backend Environment Configuration Template
# Copy this file to backend/.env and populate with your credentials.
# Never commit real API keys or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORS & Networking
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. LLM Provider (Groq / OpenAI / Mock)
# ------------------------------------------------------------------------------
# Provider options: "groq" (default production), "openai", or "mock" (offline).
LLM_PROVIDER=groq

# Primary API key for the selected provider (never commit real value).
LLM_API_KEY=<your-groq-or-openai-api-key>

# OpenAI-compatible API base endpoint.
# Groq: https://api.groq.com/openai/v1
# OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Primary model for parsing, matching, and evaluation (e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile, gpt-4o).
LLM_MODEL=openai/gpt-oss-120b

# Inexpensive lightweight model for bulk normalizations (e.g. openai/gpt-oss-20b, llama-3.1-8b-instant, gpt-4o-mini).
LLM_FAST_MODEL=openai/gpt-oss-20b

# Per-request HTTP timeout in seconds.
LLM_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. Tavus Conversational Video Interface (CVI) - AI Avatar Mock Interview
# ------------------------------------------------------------------------------
# Tavus v2 API key from https://tavus.io. When unset, runs in mock avatar mode.
TAVUS_API_KEY=<your-tavus-api-key>

# Replica face ID for the avatar interviewer (default stock face: ra066ab28864).
TAVUS_FACE_ID=ra066ab28864

# Existing Tavus PAL persona ID (optional; if left blank, created automatically on demand).
TAVUS_PAL_ID=

# Tavus v2 API Base endpoint.
TAVUS_API_BASE=https://tavusapi.com/v2

# Public URL reachable by Tavus webhooks for live status & transcript sync.
# In local development, set this to your ngrok or localtunnel URL (e.g. https://xxxx.ngrok-free.app).
WEBHOOK_BASE_URL=http://localhost:8000

# Maximum allowed duration for an interview call in minutes.
MAX_INTERVIEW_MINUTES=30

# ------------------------------------------------------------------------------
# 4. YouTube Data API v3 (Skill Prep Video Resources)
# ------------------------------------------------------------------------------
# YouTube Data API v3 key for verified prep-resource videos (optional).
YOUTUBE_API_KEY=<your-youtube-api-key>

# ------------------------------------------------------------------------------
# 5. Database Configuration
# ------------------------------------------------------------------------------
# SQLite default for local development. Use PostgreSQL for cloud deployments (e.g. on Render/Supabase).
DATABASE_URL=sqlite:///./careerbridge.db

# ------------------------------------------------------------------------------
# 6. ATS Scraper & Admin Controls
# ------------------------------------------------------------------------------
# Bearer token required to trigger POST /api/admin/scrape.
ADMIN_TOKEN=change-me-strong-token

# Scraper HTTP identity and rate limiting settings
SCRAPER_USER_AGENT=CareerBridge-Scraper/0.1 (+https://github.com/Vineethsn-007/CareerBridge)
SCRAPER_TIMEOUT=20
SCRAPER_REQUEST_INTERVAL=2.0
SCRAPER_MAX_LISTINGS=25
SCRAPER_STALE_DAYS=14
